# Django core
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourapp.azurewebsites.net,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourapp.azurewebsites.net

# Database (Postgres; omit all to fall back to local SQLite)
DB_HOST=
DB_NAME=ghashem
DB_USER=ghashemadmin
DB_PASSWORD=
DB_PORT=5432

# Azure — app registration & Key Vault
AZURE_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000
GHASHEM_SP_OBJECT_ID=00000000-0000-0000-0000-000000000000
VAULT_URL=https://your-dev-keyvault.vault.azure.net/
COMPANY_VAULT_URL=https://your-company-keyvault.vault.azure.net/

# Email (SendGrid; omit both to use console backend)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
GHASHEM_CONTACT_EMAIL=support@yourdomain.com

# Misc
SITE_URL=https://yourapp.azurewebsites.net
GHASHEM_ENVIRONMENT=development
